{
  "name": "viewer",
  "version": "1.1.7",
  "description": "IFC-Lite viewer application",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"tsx server/api.ts\"",
    "dev:vite": "vite",
    "dev:api": "tsx server/api.ts",
    "build": "NODE_OPTIONS='--max-old-space-size=4096' bash -c '(tsc || true) && vite build'",
